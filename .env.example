# ALTHEA PAY - environment template
# Never commit real credentials or production secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never expose service-role credentials in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional application origin for server-side integrations.
ALTHEA_PAY_APP_URL=http://localhost:3000

# WhatsApp (Baileys bridge in whatsapp-bridge/). Also set both as Supabase function secrets.
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
